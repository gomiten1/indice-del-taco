{"help": "https://www.datos.gob.mx/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "", "author_email": "", "creator_user_id": "b3ab95ff-3c17-4034-bd45-eb6aa1bccf52", "id": "88d47f18-3cf0-4279-b20b-00fadf73807e", "isopen": true, "license_id": "CC-BY-4.0", "license_title": "Creative Commons Attribution 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "maintainer": "Procuradur\u00eda Federal del Consumidor (PROFECO)", "maintainer_email": "", "metadata_created": "2025-12-24T21:30:24.911455", "metadata_modified": "2025-12-25T00:19:02.851319", "name": "programa_quien_es_quien_precios_2025", "notes": "El Conjunto de datos del programa Qui\u00e9n es Qui\u00e9n en los Precios integra informaci\u00f3n de precios de productos de consumo habitual en el hogar, tales como alimentos, bebidas, art\u00edculos de higiene personal y del hogar, medicamentos, electrodom\u00e9sticos y productos de temporada. Su objetivo es ofrecer informaci\u00f3n comparable que apoye a las personas consumidoras en la toma de decisiones de compra mediante la consulta y comparaci\u00f3n de precios entre distintos establecimientos.", "num_resources": 22, "num_tags": 13, "organization": {"id": "08bf2d2e-872b-450b-9e03-4980cceb60fd", "name": "profeco", "title": "Procuradur\u00eda Federal del Consumidor (PROFECO)", "type": "organization", "description": "La Procuradur\u00eda Federal del Consumidor (PROFECO) tiene como misi\u00f3n empoderar al consumidor mediante la protecci\u00f3n efectiva del ejercicio de sus derechos y la confianza ciudadana, promoviendo un consumo razonado, informado, sostenible, seguro y saludable, a fin de corregir injusticias del mercado, fortalecer el mercado interno y el bienestar de la poblaci\u00f3n.", "image_url": "2025-12-24-192816.639036PROFECOLOGO.png", "created": "2025-12-24T14:28:16.648806", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "08bf2d2e-872b-450b-9e03-4980cceb60fd", "priva